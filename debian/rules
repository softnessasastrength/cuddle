#!/usr/bin/make -f
# Debian overlay. Distro package names stay here, not in meson.build.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export CC = gcc
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

MESON_OPTIONS = \
	-Dcli=enabled \
	-Dtui=enabled \
	-Dgui=enabled \
	-Dtui_toolkit=curses \
	-Dgui_toolkit=gtk \
	-Dplugins=disabled \
	-Ddocs=enabled \
	-Dtests=enabled \
	-Di18n=auto \
	-Duser_config=enabled

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		--libdir=lib \
		-Dpkgconfigdir=lib/$(DEB_HOST_MULTIARCH)/pkgconfig \
		$(MESON_OPTIONS)

override_dh_auto_test:
	dh_auto_test -- -v
