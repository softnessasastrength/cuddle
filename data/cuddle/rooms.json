      "id": "flood",
      "title": "Flood Protocol",
      "summary": "Body first. Words optional. No essays.",
      "kind": "steps",
      "steps": [
        {
          "title": "STOP",
          "body": "You do not have to finish the thought, the text, or the build spiral. Soft Signal free.",
          "choices": []
        },
        {
          "title": "BODY",
          "body": "Feet on floor. Let your body settle if you can. Skip anything that does not work for you.",
          "choices": []
        },
        {
          "title": "WATER",
          "body": "One animal need: water, snack, cold water on face, or blanket. Pick one, or skip.",
          "choices": []
        },
        {
          "title": "DELAY",
          "body": "Delay is care, not exile. Give yourself time before sending a raw dump to another person.",
          "choices": []
        },
        {
          "title": "SOFT",
          "body": "Soft Signal is free even from yourself. You can leave this room too.",
          "choices": []
        },
        {
          "title": "LATER",
          "body": "When quieter: Conflict Practice, Want or Should, or Aftercare. Not now.",
          "choices": []
        }
      ]
    },
